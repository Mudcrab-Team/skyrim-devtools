#!/usr/bin/env python3.13
"""Build the SKSE plugin on the Windows test PC from this worktree (SPDX-License-Identifier: GPL-3.0-or-later).

  tools/pc-build --config mac.json                   incremental build
  tools/pc-build --config mac.json --deploy          build, then copy the DLL while holding agent.lock
                                                     (--with-example also deploys the example extension plugin)
  tools/pc-build --config mac.json commonlib         (re)build the shared CommonLibSSE-NG once
  tools/pc-build --config mac.json lock|unlock       hold agent.lock around a live run
  tools/pc-build --config mac.json lock --refresh    heartbeat: agent.lock goes stale 25 min after its last refresh
  tools/pc-build --config mac.json hold --lock-wait 1200 -- CMD ARGS...
                                                     take the lock (queued), run CMD with a background heartbeat
                                                     every 4 min, release the lock when CMD ends; CMD is stopped
                                                     after --max-minutes (default 20) so one hold stays bounded; the
                                                     lock is released on timeout, on exit and on SIGTERM/SIGHUP
  --lock-file probe.lock                             with lock/unlock/hold: use another lock file (tests of the lock
                                                     handling itself, while agent.lock is held by a live session)

With --lock-wait, waiting agents queue by ticket next to agent.lock and are served oldest first.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tarfile
import tempfile
import time

REPO = Path(__file__).resolve().parent.parent
REMOTE_ROOT = r".local\skyrim-devtools"
# native/ is the build tree's root; ext/ (the public extension header) and examples/ keep their names inside it
SYNC_DIRS = ["native", "ext", "examples"]
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,40}")


def fail(message, code=1):
    print(f"pc-build: {message}", file=sys.stderr)
    sys.exit(code)


class Host:
    def __init__(self, config):
        destination = config["sshDestination"]
        if not isinstance(destination, str) or not destination or destination.startswith("-"):
            fail("Set an SSH destination or alias in the local configuration")
        opts = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ServerAliveInterval=15"]
        if path := config.get("sshConfig"):
            opts += ["-F", str(Path(path).expanduser())]
        self.opts = opts
        self.destination = destination

    def run(self, command, check=True, stream=False):
        argv = ["ssh", *self.opts, "-T", self.destination, command]
        if stream:
            return subprocess.run(argv).returncode
        result = subprocess.run(argv, capture_output=True, text=True)
        if check and result.returncode:
            fail(f"remote command failed ({result.returncode}): {result.stderr.strip()[:400]}")
        return result

    def put(self, local, remote):
        result = subprocess.run(["scp", "-q", *self.opts, str(local), f"{self.destination}:{remote}"],
                                capture_output=True, text=True)
        if result.returncode:
            fail(f"scp failed: {result.stderr.strip()[:400]}")


def remote_path(relative):
    return relative.removeprefix("native/")


def scan():
    files = {}
    for directory in SYNC_DIRS:
        for path in sorted((REPO / directory).rglob("*")):
            if path.is_file() and "__pycache__" not in path.parts:
                relative = path.relative_to(REPO).as_posix()
                files[relative] = hashlib.sha1(path.read_bytes()).hexdigest()
    return files


def build_id(files):
    """Git sha, a dirty marker and a hash of native/, so the DLL says which sources it was built from."""
    def git(*args):
        return subprocess.run(["git", "-C", str(REPO), *args], capture_output=True, text=True).stdout.strip()

    sha = git("rev-parse", "--short=10", "HEAD") or "nogit"
    dirty = "-dirty" if git("status", "--porcelain", "--", "native") else ""
    digest = hashlib.sha1("".join(f"{f}={d}" for f, d in sorted(files.items())).encode()).hexdigest()[:10]
    return f"{sha}{dirty}:{digest}"


def sync(host, name, full):
    """Ship only files whose content changed; unchanged files keep their remote mtime so Ninja skips them."""
    state_file = REPO / "build" / f"pc-build-{name}.json"
    previous = {}
    if state_file.exists() and not full:
        previous = json.loads(state_file.read_text())
    current = scan()
    stamp = f'#define DEVTOOLS_BUILD_ID "{build_id(current)}"\n'
    current["native/build_id.h"] = hashlib.sha1(stamp.encode()).hexdigest()
    changed = [f for f, digest in current.items() if previous.get(f) != digest]
    removed = [f for f in previous if f not in current]
    if changed or removed or full or not previous:
        with tempfile.TemporaryDirectory() as tmp:
            archive = Path(tmp) / "src.tar"
            manifest = Path(tmp) / "removed.txt"
            manifest.write_text("\n".join(remote_path(r) for r in removed))
            with tarfile.open(archive, "w") as tar:
                for relative in changed:
                    if relative != "native/build_id.h":
                        tar.add(REPO / relative, arcname=remote_path(relative))
                if "native/build_id.h" in changed:
                    header = Path(tmp) / "build_id.h"
                    header.write_text(stamp)
                    tar.add(header, arcname="build_id.h")
                tar.add(manifest, arcname="removed.txt")
            host.put(archive, rf"{REMOTE_ROOT}\pc-build-{name}.tar")
        wipe = " -Wipe" if (full or not previous) else ""
        code = run_remote(host, f"-Action sync -Name {name}{wipe}")
        if code:
            fail("remote extract failed")
    state_file.parent.mkdir(exist_ok=True)
    state_file.write_text(json.dumps(current))
    return len(changed), len(removed)


def run_remote(host, args):
    script = REPO / "tools" / "pc_build_remote.ps1"
    host.put(script, rf"{REMOTE_ROOT}\pc_build_remote.ps1")
    command = (rf"powershell -NoProfile -ExecutionPolicy Bypass -File "
               rf"{REMOTE_ROOT}\pc_build_remote.ps1 {args}")
    return host.run(command, stream=True)


HEARTBEAT_SECONDS = 240
UNLOCK_ATTEMPTS = 3
LOCK_ARGS = ""  # set from --lock-file
RETRY_DELAY = 2


def supervise(argv, max_seconds):
    """Run a command in its own process group and stop the whole group when the time limit passes.

    A grandchild left running (a game driver spawning helpers) would otherwise outlive the hold."""
    child = subprocess.Popen(argv, start_new_session=True)

    def stop_group(sig):
        try:
            os.killpg(child.pid, sig)
        except ProcessLookupError:
            pass

    try:
        return child.wait(timeout=max_seconds)
    except subprocess.TimeoutExpired:
        stop_group(signal.SIGTERM)
        try:
            child.wait(timeout=10)
        except subprocess.TimeoutExpired:
            stop_group(signal.SIGKILL)
            child.wait()
        print(f"pc-build: stopped the command after {max_seconds / 60:g} min (lock hold limit)", file=sys.stderr)
        return 124
    except BaseException:
        # interrupted or terminated while waiting: the command must not keep running without the lock
        stop_group(signal.SIGTERM)
        raise


def release_lock(host, name, remote=None):
    """Give agent.lock back, retrying: a lock left behind blocks every other agent for 25 minutes."""
    remote = remote or run_remote
    for attempt in range(UNLOCK_ATTEMPTS):
        code = remote(host, f"-Action unlock -Agent {name} -LockWait 0{LOCK_ARGS}")
        if code == 0:
            return True
        if code == 4:
            # the lock belongs to someone else now: ours is already gone, nothing to retry
            return False
        time.sleep(RETRY_DELAY)
    print(f"pc-build: could not release agent.lock for {name}; it goes stale 25 min after its last refresh", file=sys.stderr)
    return False


def hold(host, options, argv):
    """Own agent.lock around a long command: refresh it in the background, always release it."""
    import threading

    name = options.name
    wait = f"-Action lock -Agent {name} -LockWait {options.lock_wait}{LOCK_ARGS}"
    code = run_remote(host, wait)
    if code:
        fail(f"could not take agent.lock (exit {code}); it is held by another agent", code)
    stop = threading.Event()
    lost = threading.Event()

    def beat():
        while not stop.wait(HEARTBEAT_SECONDS):
            result = host.run(rf"powershell -NoProfile -ExecutionPolicy Bypass -File {REMOTE_ROOT}\pc_build_remote.ps1 "
                              f"-Action lock -Agent {name} -LockWait 0 -Refresh{LOCK_ARGS}", check=False)
            if result.returncode:
                lost.set()
                print("pc-build: agent.lock refresh failed; the lock is no longer ours", file=sys.stderr)

    # a terminate or hangup of pc-build itself must still run the release below
    previous = {}
    for sig in (signal.SIGTERM, signal.SIGHUP):
        previous[sig] = signal.signal(sig, lambda number, frame: sys.exit(128 + number))
    thread = threading.Thread(target=beat, daemon=True)
    thread.start()
    status = 1
    try:
        status = supervise(argv, options.max_minutes * 60)
    finally:
        stop.set()
        release_lock(host, name)
        for sig, handler in previous.items():
            signal.signal(sig, handler)
    if lost.is_set() and status == 0:
        status = 125
    return status


def main():
    argv = sys.argv[1:]
    rest = []
    if "--" in argv:
        split = argv.index("--")
        argv, rest = argv[:split], argv[split + 1:]
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", nargs="?", default="build", choices=["build", "commonlib", "lock", "unlock", "hold"])
    parser.add_argument("--config", type=Path, default=os.environ.get("SKYRIM_DEVTOOLS_CONFIG"))
    parser.add_argument("--name", default=REPO.name, help="build directory and agent name (default: worktree name)")
    parser.add_argument("--deploy", action="store_true", help="copy the DLL into the game while holding agent.lock")
    parser.add_argument("--with-example", action="store_true",
                        help="with --deploy: also copy the example extension plugin (examples/hello-ext) into the game")
    parser.add_argument("--keep-lock", action="store_true", help="with --deploy: keep agent.lock for the live run")
    parser.add_argument("--lock-wait", type=int, default=0, metavar="SECONDS", help="wait this long for agent.lock")
    parser.add_argument("--refresh", action="store_true",
                        help="with lock: touch agent.lock if this agent holds it (non-zero exit if not); long holders call it every few minutes")
    parser.add_argument("--lock-file", default="agent.lock", metavar="NAME.lock",
                        help="lock/unlock/hold on this lock file instead of agent.lock (a probe lock for tests)")
    parser.add_argument("--max-minutes", type=float, default=20, help="with hold: stop the command after this long")
    parser.add_argument("--full", action="store_true", help="resend every source file")
    parser.add_argument("--reconfigure", action="store_true", help="delete the build directory first")
    parser.add_argument("--no-prebuilt", action="store_true", help="compile CommonLib inside the build directory")
    options = parser.parse_args(argv)
    if not options.config:
        fail("pass --config or set SKYRIM_DEVTOOLS_CONFIG")
    if not NAME_RE.fullmatch(options.name):
        fail("name must be letters, digits, dot, dash or underscore")
    global LOCK_ARGS
    if options.lock_file != "agent.lock":
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,40}\.lock", options.lock_file):
            fail("lock file must look like NAME.lock")
        LOCK_ARGS = f" -LockFile {options.lock_file}"
    host = Host(json.loads(options.config.read_text()))
    started = time.monotonic()

    if options.command == "hold":
        if not rest:
            fail("hold needs a command after --")
        sys.exit(hold(host, options, rest))

    if options.command in {"lock", "unlock"}:
        refresh = " -Refresh" if options.refresh and options.command == "lock" else ""
        sys.exit(run_remote(host, f"-Action {options.command} -Agent {options.name} -LockWait {options.lock_wait}{refresh}{LOCK_ARGS}"))

    t = time.monotonic()
    changed, removed = sync(host, options.name, options.full)
    print(f"[time] sync {time.monotonic() - t:.1f}s ({changed} changed, {removed} removed)")
    flags = f"-Name {options.name}"
    if options.command == "commonlib":
        code = run_remote(host, f"-Action commonlib {flags}")
    else:
        flags += " -Action build"
        if options.deploy:
            flags += f" -Deploy -Agent {options.name} -LockWait {options.lock_wait}"
            if options.keep_lock:
                flags += " -KeepLock"
            if options.with_example:
                flags += " -WithExample"
        if options.reconfigure:
            flags += " -Reconfigure"
        if options.no_prebuilt:
            flags += " -NoPrebuilt"
        code = run_remote(host, flags)
    print(f"[time] total {time.monotonic() - started:.1f}s")
    sys.exit(code)


if __name__ == "__main__":
    main()
